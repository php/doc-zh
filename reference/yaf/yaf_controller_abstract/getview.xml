<refentry xml:id="yaf-controller-abstract.getview" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Controller_Abstract::getView</refname>
  <refpurpose>获取视图引擎</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type class="union"><type>Yaf_View_Interface</type><type>null</type></type><methodname>Yaf_Controller_Abstract::getView</methodname>
   <void />
  </methodsynopsis>
  <simpara>
   返回绑定到该控制器的视图引擎。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   <classname>Yaf_View_Interface</classname> 实例，如果没有可用的视图引擎则返回 &null;。
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Controller_Abstract::getView</methodname> 示例</title>
   <programlisting role="php">
<![CDATA[
<?php
class ProductController extends Yaf_Controller_Abstract
{
    public function indexAction() {
        $view = $this->getView();

        // 把 $products 导出到模板 product/index.phtml
        $view->assign("products", array("yaf", "php"));
    }
}
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><methodname>Yaf_Controller_Abstract::initView</methodname></member>
    <member><classname>Yaf_View_Interface</classname></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

