<refentry xml:id="yaf-application.getmodules" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Application::getModules</refname>
  <refpurpose>获取定义的模块名</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type class="union"><type>array</type><type>null</type></type><methodname>Yaf_Application::getModules</methodname>
   <void />
  </methodsynopsis>
  <simpara>
   获取在 <link linkend="configuration.yaf.modules">application.modules</link>
   配置项中定义的模块名。如果没有定义，则始终有一个名为
   <literal>"Index"</literal> 的模块。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   模块名数组，如果应用没有正确初始化则返回 &null;。
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><function>Yaf_Application::getModules</function> 示例</title>
   <programlisting role="php">
<![CDATA[
<?php
$config = array(
    "application" => array(
        "directory" => realpath(dirname(__FILE__)) . "/application",
    ),
);

/** Yaf_Application */
$application = new Yaf_Application($config);
print_r($application->getModules());
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
Array
(
    [0] => Index
)
]]>
   </screen>
  </example>
 </refsect1>

</refentry>

