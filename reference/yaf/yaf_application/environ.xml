<refentry xml:id="yaf-application.environ" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Application::environ</refname>
  <refpurpose>检索环境名</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type class="union"><type>string</type><type>null</type></type><methodname>Yaf_Application::environ</methodname>
   <void />
  </methodsynopsis>
  <simpara>
   返回应用的环境名，它由 <link linkend="ini.yaf.environ">yaf.environ</link>
   指令（或构造函数的 <parameter>environ</parameter> 参数）定义，默认值为
   <literal>"product"</literal>。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   应用的环境名。
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><function>Yaf_Application::environ</function> 示例</title>
   <programlisting role="php">
<![CDATA[
<?php
$config = array(
    "application" => array(
        "directory" => realpath(dirname(__FILE__)) . "/application",
    ),
);

/** Yaf_Application */
$application = new Yaf_Application($config);
print_r($application->environ());
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
product
]]>
   </screen>
  </example>
 </refsect1>

</refentry>

