<refentry xml:id="yaf-action-abstract.getcontroller" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Action_Abstract::getController</refname>
  <refpurpose>获取控制器对象</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier><type linkend="class.yaf-controller-abstract" class="union"><type>Yaf_Controller_Abstract</type><type>null</type></type><methodname>Yaf_Action_Abstract::getController</methodname>
   <void />
  </methodsynopsis>
  <simpara>
   获取拥有此动作的控制器。
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   返回 <classname>Yaf_Controller_Abstract</classname> 实例，
   如果没有可用的控制器则返回 &null;。
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Action_Abstract::getController</methodname> 示例</title>
   <programlisting role="php">
<![CDATA[
<?php
class ListAction extends Yaf_Action_Abstract
{
    public function execute() {
        // 拥有此动作的控制器
        $controller = $this->getController();
        var_dump($controller instanceof Yaf_Controller_Abstract);

        // 例如：访问它的视图引擎
        $controller->getView()->assign("products", array("yaf", "php"));
    }
}
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
bool(true)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
