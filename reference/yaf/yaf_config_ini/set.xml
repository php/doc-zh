<refentry xml:id="yaf-config-ini.set" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Config_Ini::set</refname>
<refpurpose>设置配置值</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>bool</type><methodname>Yaf_Config_Ini::set</methodname>
   <methodparam><type>string</type><parameter>name</parameter></methodparam>
   <methodparam><type>mixed</type><parameter>value</parameter></methodparam>
  </methodsynopsis>
  <simpara>尝试设置配置值。由于 <classname>Yaf_Config_Ini</classname> 始终只读，此方法总是失败并触发一条警告。</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>name</parameter></term>
    <listitem>
<simpara>要设置的配置键。</simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>value</parameter></term>
    <listitem>
<simpara>要赋的值。</simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>由于 <classname>Yaf_Config_Ini</classname> 是只读的，始终返回 &false; 并触发一条警告。</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Config_Ini::set</methodname> 示例</title>
   <programlisting role="php">
<![CDATA[
<?php
/**
 * 假设 /etc/myapp/application.ini 包含：
 * [common]
 * application.name = "MyApp"
 * database.host    = "localhost"
 * database.port    = 3306
 */
$config = new Yaf_Config_Ini('/etc/myapp/application.ini', 'common');

// 只读：赋值总是失败，并触发一条警告
var_dump($config->set('database.host', '192.0.2.10'));

echo $config->get('database.host'), "\n";
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
bool(false)
localhost
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Config_Ini::get</methodname></member>
   <member><methodname>Yaf_Config_Ini::readonly</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

