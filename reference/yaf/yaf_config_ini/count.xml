<refentry xml:id="yaf-config-ini.count" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Config_Ini::count</refname>
<refpurpose>统计配置项的数量</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>int</type><methodname>Yaf_Config_Ini::count</methodname>
   <void />
  </methodsynopsis>
  <simpara>返回顶层配置项的数量。</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>以整数形式返回顶层配置项的数量。</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Config_Ini::count</methodname> 示例</title>
   <programlisting role="php">
<![CDATA[
<?php
/**
 * 假设 /etc/myapp/application.ini 包含：
 * [common]
 * application.name = "MyApp"
 * database.host    = "localhost"
 * database.port    = 3306
 */
$config = new Yaf_Config_Ini('/etc/myapp/application.ini', 'common');

// 只统计顶层配置项（"application" 和 "database"）
var_dump(count($config));
var_dump($config->count());
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
int(2)
int(2)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Config_Ini::get</methodname></member>
   <member><methodname>Yaf_Config_Ini::toArray</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

