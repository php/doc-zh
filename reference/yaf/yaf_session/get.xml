<refentry xml:id="yaf-session.get" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Session::get</refname>
<refpurpose>获取会话值</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>mixed</type><methodname>Yaf_Session::get</methodname>
   <methodparam choice="opt"><type>string</type><parameter>name</parameter><initializer>NULL</initializer></methodparam>
  </methodsynopsis>
  <simpara>按名字获取会话值。如果省略 <parameter>name</parameter> 或其值为 &null;，则返回整个会话数组。</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>name</parameter></term>
    <listitem>
<simpara>要获取的会话键，传 &null; 则获取全部会话数据。</simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>会话值，键不存在时返回 &null;。当 <parameter>name</parameter> 为 &null; 时，返回完整的会话数组。</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Session::get</methodname> 示例</title>
   <programlisting role="php">
<![CDATA[
<?php
class ProfileController extends Yaf_Controller_Abstract
{
    public function indexAction()
    {
        $session = Yaf_Session::getInstance();
        $session->start();

        $userId = $session->get("user_id");
        if ($userId === null) {
            return $this->redirect("/account/login");
        }

        echo "welcome back, user #", $userId;
    }
}
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Session::set</methodname></member>
   <member><methodname>Yaf_Session::has</methodname></member>
   <member><methodname>Yaf_Session::del</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

