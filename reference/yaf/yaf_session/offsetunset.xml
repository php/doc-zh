<refentry xml:id="yaf-session.offsetunset" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Session::offsetUnset</refname>
<refpurpose>移除会话键（ArrayAccess）</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>void</type><methodname>Yaf_Session::offsetUnset</methodname>
   <methodparam><type>mixed</type><parameter>name</parameter></methodparam>
  </methodsynopsis>
  <simpara>移除一个会话键及其值。当对会话对象使用数组语法调用 <literal>unset()</literal> 时，会调用此方法。</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>name</parameter></term>
    <listitem>
<simpara>要移除的会话键。</simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>没有返回值。</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Session::offsetUnset</methodname> 示例</title>
   <programlisting role="php">
<![CDATA[
<?php
$session = Yaf_Session::getInstance();
$session->start();

$session["captcha_code"] = "8X2Q";

// ... 验证码校验通过后，删除这个一次性验证码
unset($session["captcha_code"]);

var_dump(isset($session["captcha_code"]));
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
bool(false)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Session::del</methodname></member>
   <member><methodname>Yaf_Session::offsetGet</methodname></member>
   <member><methodname>Yaf_Session::offsetSet</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

