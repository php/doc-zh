<refentry xml:id="yaf-session.set" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
<refname>Yaf_Session::set</refname>
<refpurpose>设置会话值</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>bool</type><methodname>Yaf_Session::set</methodname>
   <methodparam><type>string</type><parameter>name</parameter></methodparam>
   <methodparam><type>mixed</type><parameter>value</parameter></methodparam>
  </methodsynopsis>
  <simpara>设置一个会话值。</simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>name</parameter></term>
    <listitem>
<simpara>要设置的会话键。</simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>value</parameter></term>
    <listitem>
<simpara>要存储的值。</simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>成功时返回 &true;，失败时返回 &false;。</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title><methodname>Yaf_Session::set</methodname> 示例</title>
   <programlisting role="php">
<![CDATA[
<?php
class LoginController extends Yaf_Controller_Abstract
{
    public function indexAction()
    {
        // ... 根据数据库验证用户凭证
        $session = Yaf_Session::getInstance();
        $session->start();

        $session->set("user_id", $user->getId());
        $session->set("login_time", time());

        return $this->redirect("/dashboard");
    }
}
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Session::get</methodname></member>
   <member><methodname>Yaf_Session::has</methodname></member>
   <member><methodname>Yaf_Session::del</methodname></member>
  </simplelist>
 </refsect1>
</refentry>

